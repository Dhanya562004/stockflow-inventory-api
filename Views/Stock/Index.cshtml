@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Stock Adjustment - StockFlow</title>
    <link rel="stylesheet" href="/css/stock.css" />
</head>
<body>
    <main class="stock-container">
        <h1>Stock Adjustment</h1>

        <form id="stockAdjustmentForm" novalidate>
            <div class="form-group">
                <label for="productId">Product ID (GUID):</label>
                <input type="text" id="productId" name="productId" required placeholder="e.g. 3fa85f64-5717-4562-b3fc-2c963f66afa6" autocomplete="off" />
                <div class="help-text">Enter the unique identifier of the product.</div>
            </div>

            <div class="form-group">
                <label for="delta">Adjustment Amount (Delta):</label>
                <input type="number" id="delta" name="delta" required placeholder="e.g. 5 or -2" step="1" />
                <div class="help-text">Positive values increase stock; negative values decrease stock.</div>
            </div>

            <button type="submit" id="submitBtn">Adjust Stock</button>
        </form>

        <div id="statusMessage" class="status-box" role="alert" aria-live="polite"></div>
        <div id="quantityDisplay" class="quantity-display" aria-live="polite"></div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('stockAdjustmentForm');
            const productIdInput = document.getElementById('productId');
            const deltaInput = document.getElementById('delta');
            const statusMessage = document.getElementById('statusMessage');
            const quantityDisplay = document.getElementById('quantityDisplay');
            const submitBtn = document.getElementById('submitBtn');

            form.addEventListener('submit', async function (event) {
                event.preventDefault();

                statusMessage.className = 'status-box';
                statusMessage.textContent = '';
                quantityDisplay.textContent = '';

                const productId = productIdInput.value.trim();
                const deltaValue = parseInt(deltaInput.value, 10);

                if (!productId) {
                    statusMessage.className = 'status-box error';
                    statusMessage.textContent = 'Please enter a valid Product ID.';
                    return;
                }

                if (isNaN(deltaValue) || deltaValue === 0) {
                    statusMessage.className = 'status-box error';
                    statusMessage.textContent = 'Please enter a non-zero adjustment amount (delta).';
                    return;
                }

                submitBtn.disabled = true;

                try {
                    const response = await fetch('/api/stock/adjust', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({
                            productId: productId,
                            delta: deltaValue
                        })
                    });

                    let data = null;
                    try {
                        data = await response.json();
                    } catch (e) {
                        data = null;
                    }

                    if (response.status === 200) {
                        statusMessage.className = 'status-box success';
                        statusMessage.textContent = data && data.message ? data.message : 'Stock adjusted successfully.';
                        const newQuantity = data && data.quantity !== undefined ? data.quantity : 'N/A';
                        quantityDisplay.textContent = 'Updated Quantity: ' + newQuantity;
                    } else if (response.status === 409) {
                        statusMessage.className = 'status-box error';
                        statusMessage.textContent = data && data.message ? data.message : 'Adjustment rejected: resulting stock cannot be negative.';
                    } else if (response.status === 404) {
                        statusMessage.className = 'status-box error';
                        statusMessage.textContent = data && data.message ? data.message : 'Product not found.';
                    } else if (response.status === 400) {
                        statusMessage.className = 'status-box error';
                        statusMessage.textContent = data && data.message ? data.message : 'Validation failed. Please verify the input values.';
                    } else {
                        statusMessage.className = 'status-box error';
                        statusMessage.textContent = data && data.message ? data.message : 'An error occurred (' + response.status + ').';
                    }
                } catch (err) {
                    statusMessage.className = 'status-box error';
                    statusMessage.textContent = 'Network or server communication failure.';
                } finally {
                    submitBtn.disabled = false;
                }
            });
        });
    </script>
</body>
</html>
