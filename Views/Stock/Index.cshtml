@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Stock Adjustment - StockFlow</title>
    <link rel="stylesheet" href="/css/stock.css" />
</head>
<body>
    <main class="stock-container">
        <h1>Stock Adjustment</h1>

        <form id="stockAdjustmentForm" novalidate>
            <div class="form-group">
                <label for="productId">Product ID (GUID):</label>
                <input type="text" id="productId" name="productId" required placeholder="e.g. 3fa85f64-5717-4562-b3fc-2c963f66afa6" autocomplete="off" />
                <div class="help-text">Enter the unique identifier of the product.</div>
            </div>

            <div class="form-group">
                <label for="delta">Adjustment Amount (Delta):</label>
                <input type="number" id="delta" name="delta" required placeholder="e.g. 5 or -2" step="1" />
                <div class="help-text">Positive values increase stock; negative values decrease stock.</div>
            </div>

            <button type="submit" id="submitBtn">Adjust Stock</button>
        </form>

        <div id="statusMessage" class="status-box" role="status" aria-live="polite"></div>
        <div id="quantityDisplay" class="quantity-display" role="status" aria-live="polite"></div>

        <section class="catalog-section" aria-labelledby="catalogHeading">
            <h2 id="catalogHeading">Product Catalog</h2>
            <div id="emptyState" class="empty-state" role="status" aria-live="polite" style="display: none;">No products available.</div>
            <table id="productTable" class="product-table" aria-label="Product Catalog" style="display: none;">
                <thead>
                    <tr>
                        <th scope="col">Product Name</th>
                        <th scope="col">SKU</th>
                        <th scope="col">Current Stock</th>
                        <th scope="col">Product ID</th>
                        <th scope="col">Action</th>
                    </tr>
                </thead>
                <tbody id="productTableBody"></tbody>
            </table>
        </section>

        <section class="ai-assistant-section" aria-labelledby="aiHeading">
            <h2 id="aiHeading">AI Inventory Replenishment Advisor</h2>
            <p class="section-description">Analyze low-stock items across catalog thresholds using AI to generate actionable replenishment recommendations.</p>
            
            <div class="ai-controls">
                <div class="form-group inline-group">
                    <label for="aiThreshold">Low-Stock Threshold:</label>
                    <input type="number" id="aiThreshold" name="aiThreshold" value="20" min="0" max="1000" step="1" />
                </div>
                <button type="button" id="aiAnalyzeBtn" class="ai-btn">Analyze Stock with AI</button>
            </div>

            <div id="aiLoadingIndicator" class="ai-loading" role="status" aria-live="polite" style="display: none;">
                <span class="spinner" aria-hidden="true"></span>
                <span id="aiLoadingText">Analyzing low-stock inventory via AI...</span>
            </div>

            <div id="aiStatusMessage" class="status-box" role="status" aria-live="polite"></div>

            <div id="aiResultCard" class="ai-result-card" style="display: none;" aria-live="polite">
                <div class="ai-card-header">
                    <span class="ai-badge">AI Replenishment Analysis</span>
                    <span id="aiItemsCount" class="ai-items-count"></span>
                </div>
                <div class="ai-card-body">
                    <h3 class="ai-subheading">Executive Summary</h3>
                    <p id="aiExecutiveSummary" class="ai-summary-text"></p>
                    
                    <h3 class="ai-subheading">Recommended Replenishment Action</h3>
                    <div id="aiRecommendedAction" class="ai-action-box"></div>

                    <h3 class="ai-subheading">Identified At-Risk SKUs</h3>
                    <ul id="aiItemsList" class="ai-items-list"></ul>
                </div>
            </div>
        </section>
    </main>

    <script src="/js/stock.js"></script>
</body>
</html>
