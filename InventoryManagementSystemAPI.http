// POST -> Register User
POST {{InventoryManagementSystemAPI_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "testmanager@system.com",
  "password": "TestManager@12345$",
  "firstName": "Test",
  "lastName": "Manager"
}

###

// POST -> Login Normal User -> ** COPY TOKEN FROM RESPONSE **
POST {{InventoryManagementSystemAPI_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "testnewuser@test.com",
  "password": "TestNew@12345"
}

###

// POST -> Login Manager User -> ** COPY TOKEN FROM RESPONSE **
POST {{InventoryManagementSystemAPI_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "testmanager@system.com",
  "password": "TestManager@12345$"
}

###

// POST -> Login Admin User -> ** COPY TOKEN FROM RESPONSE **
POST {{InventoryManagementSystemAPI_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@system.com",
  "password": "Admin@12345!"
}

###

// POST -> Get Current User
GET {{InventoryManagementSystemAPI_HostAddress}}/api/auth/me
Authorization: Bearer {{token}}

###

// POST -> Role Protection -> Normal User
POST {{InventoryManagementSystemAPI_HostAddress}}/api/auth/assign-role
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "testuser@test.com",
  "role"": "Admin"
}

###

// POST -> Role Protection -> Admin User
POST {{InventoryManagementSystemAPI_HostAddress}}/api/auth/assign-role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "email": "admin@system.com",
  "role": "Admin"
}

###

// POST -> Change Password
POST {{InventoryManagementSystemAPI_HostAddress}}/api/auth/change-password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "Test@12345",
  "newPassword": "NewPass@12345"
}

###

// POST -> Assign Role 
POST {{InventoryManagementSystemAPI_HostAddress}}/api/auth/assign-role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "email": "testmanager@system.com",
  "role": "Manager"
}

###

// *** VALIDATION ENDPOINTS ***

