@model IEnumerable<StockFlow.LegacyMvc5.Models.LegacyProduct>
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Legacy Stock Management - ASP.NET MVC 5 (.NET Framework 4.8)</title>
    <style>
        body { font-family: Tahoma, Arial, sans-serif; margin: 20px; background-color: #f0f0f0; color: #333; }
        .container { max-width: 900px; margin: 0 auto; background: #fff; padding: 25px; border: 1px solid #ccc; box-shadow: 2px 2px 5px #ddd; }
        .legacy-banner { background-color: #fffae6; border: 1px solid #ffe58f; padding: 10px 15px; margin-bottom: 20px; font-size: 13px; }
        .success-box { background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; padding: 10px; margin-bottom: 15px; }
        .error-box { background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; padding: 10px; margin-bottom: 15px; }
        .table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        .table th, .table td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        .table th { background-color: #eaeaea; }
        .form-group { margin-bottom: 12px; }
        .form-group label { display: block; font-weight: bold; margin-bottom: 4px; }
        .form-control { width: 100%; max-width: 350px; padding: 6px; box-sizing: border-box; }
        .btn-submit { background-color: #005ea6; color: #fff; border: none; padding: 8px 16px; cursor: pointer; font-weight: bold; }
        .btn-submit:hover { background-color: #004477; }
    </style>
</head>
<body>
    <div class="container">
        <h2>Legacy Stock Management Console</h2>
        <div class="legacy-banner">
            <strong>Architecture Notice:</strong> Running on <em>@ViewBag.FrameworkVersion</em> (System.Web.Mvc / IIS Pipeline). Server Time: @ViewBag.ServerTime
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-box">@TempData["SuccessMessage"]</div>
        }

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="error-box">@ViewBag.ErrorMessage</div>
        }

        <h3>Adjust Product Stock</h3>
        @using (Html.BeginForm("Adjust", "Stock", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label for="ProductId">Product ID (GUID):</label>
                <input type="text" id="ProductId" name="ProductId" class="form-control" placeholder="Enter Product GUID" required />
            </div>

            <div class="form-group">
                <label for="Delta">Adjustment Amount (Delta):</label>
                <input type="number" id="Delta" name="Delta" class="form-control" placeholder="e.g. 10 or -5" required />
            </div>

            <button type="submit" class="btn-submit">Submit Legacy Adjustment</button>
        }

        <hr />

        <h3>Product Inventory Table</h3>
        <table class="table">
            <thead>
                <tr>
                    <th>Product Name</th>
                    <th>SKU</th>
                    <th>Current Stock</th>
                    <th>Reorder Level</th>
                    <th>Product ID</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.SKU</td>
                            <td>@item.QuantityInStock</td>
                            <td>@item.ReorderLevel</td>
                            <td><code>@item.Id</code></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align:center;">No products returned from database.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
